@page "/estudiantes"
@using Microsoft.EntityFrameworkCore
@using BlazorApp11.Data
@using BlazorApp11.Models
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Estudiantes</PageTitle>
<h3>Estudiantes</h3>

<EditForm Model="@estudiante" OnValidSubmit="GuardarEstudiante" FormName="guardarEstudianteForm">
    <DataAnnotationsValidator />

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Nombre</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="estudiante.Nombre" />
            <ValidationMessage For="@(() => estudiante.Nombre)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Correo</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="estudiante.Correo" />
            <ValidationMessage For="@(() => estudiante.Correo)" class="text-danger" />
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label">Calificación</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="estudiante.Calificacion" />
            <ValidationMessage For="@(() => estudiante.Calificacion)" class="text-danger" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mb-4">
        @(estudiante.Id == 0 ? "Guardar" : "Actualizar")
    </button>
    @if (estudiante.Id != 0)
    {
        <button type="button" class="btn btn-secondary mb-4" @onclick="CancelarEdicion">Cancelar</button>
    }
</EditForm>

@if (listaEstudiantes.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Calificación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in listaEstudiantes)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Correo</td>
                    <td>@item.Calificacion</td>
                    <td>
                        <button class="btn btn-link text-primary p-0 border-0 me-2"
                                @onclick="() => EditarEstudiante(item)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-link text-danger p-0 border-0"
                                @onclick="() => EliminarEstudiante(item)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Estudiante estudiante = new();
    private List<Estudiante> listaEstudiantes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    // READ
    private async Task CargarEstudiantes()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        listaEstudiantes = await context.Estudiantes
            .AsNoTracking()
            .OrderBy(e => e.Id)
            .ToListAsync();
    }

    // CREATE y UPDATE
    private async Task GuardarEstudiante()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        if (estudiante.Id == 0)
            context.Estudiantes.Add(estudiante);
        else
            context.Estudiantes.Update(estudiante);

        await context.SaveChangesAsync();

        estudiante = new Estudiante();
        await CargarEstudiantes();
    }

    private void EditarEstudiante(Estudiante item)
    {
        estudiante = new Estudiante
        {
            Id = item.Id,
            Nombre = item.Nombre,
            Correo = item.Correo,
            Calificacion = item.Calificacion
        };
    }

    private void CancelarEdicion()
    {
        estudiante = new Estudiante();
    }

    // DELETE
    private async Task EliminarEstudiante(Estudiante item)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var existente = await context.Estudiantes.FindAsync(item.Id);
        if (existente != null)
        {
            context.Estudiantes.Remove(existente);
            await context.SaveChangesAsync();
        }
        await CargarEstudiantes();
    }
}